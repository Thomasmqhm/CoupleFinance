<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F5F2"
    android:orientation="vertical" >

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F9F5F2"
        android:orientation="vertical"
        android:paddingEnd="32dp"
        android:paddingStart="32dp"
        android:paddingTop="28dp" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.12"
            android:text="CONFIGURATION"
            android:textColor="#8B6914"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Paramètres du Foyer"
            android:textColor="#1A2E2B"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Personnalisez votre espace commun."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- ONGLETS style underline -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:orientation="vertical" >

                <Button
                    android:id="@+id/btnTabPersonnes"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp"
                    android:paddingStart="0dp"
                    android:text="PERSONNES &amp; COULEURS"
                    android:textColor="#C0614A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#C0614A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:orientation="vertical" >

                <Button
                    android:id="@+id/btnTabCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp"
                    android:paddingStart="0dp"
                    android:text="CATÉGORIES"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <Button
                    android:id="@+id/btnTabCharges"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp"
                    android:paddingStart="0dp"
                    android:text="CHARGES FIXES"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Séparateur pleine largeur -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8DDD6" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:paddingEnd="32dp"
            android:paddingStart="32dp"
            android:paddingTop="24dp" >

            <!-- ╔══════════════════════╗ -->
            <!-- ║ ONGLET PERSONNES      ║ -->
            <!-- ╚══════════════════════╝ -->

            <LinearLayout
                android:id="@+id/tabPersonnes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <!-- Cartes personnes côte à côte -->

                <LinearLayout
                    android:id="@+id/listPersonnes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal" />

                <!-- Ajouter personne -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" >

                    <EditText
                        android:id="@+id/etNewPerson"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nom de la personne"
                        android:paddingStart="16dp"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAddPerson"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="20dp"
                        android:paddingStart="20dp"
                        android:text="+ Inviter"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Séparateur -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    android:background="#F0EAE5" />

                <!-- Code invitation -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.10"
                    android:text="CODE D&apos;INVITATION"
                    android:textColor="#8B6914"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_beige"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp" >

                    <TextView
                        android:id="@+id/tvCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.3"
                        android:text="——————"
                        android:textColor="#1A2E2B"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="📋  Copier le code d&apos;invitation"
                    android:textColor="#1A2E2B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLeaveHousehold"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="Quitter le foyer"
                    android:textColor="#C0614A"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_rounded_danger"
                    android:text="Se déconnecter"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ╔══════════════════════╗ -->
            <!-- ║ ONGLET CATÉGORIES     ║ -->
            <!-- ╚══════════════════════╝ -->

            <LinearLayout
                android:id="@+id/tabCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Catégories"
                    android:textColor="#1A2E2B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Ajoutez, renommez ou supprimez des catégories."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <!-- Revenus -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" >

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#16A34A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revenus"
                        android:textColor="#16A34A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listCatIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal" >

                    <EditText
                        android:id="@+id/etNewIncomeCat"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nouvelle catégorie de revenu"
                        android:paddingStart="12dp"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAddIncomeCat"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:text="Ajouter"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Dépenses -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" >

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#C0614A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dépenses"
                        android:textColor="#C0614A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listCatExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                    <EditText
                        android:id="@+id/etNewExpenseCat"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nouvelle catégorie de dépense"
                        android:paddingStart="12dp"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnAddExpenseCat"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="16dp"
                        android:paddingStart="16dp"
                        android:text="Ajouter"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- ╔══════════════════════╗ -->
            <!-- ║ ONGLET CHARGES FIXES  ║ -->
            <!-- ╚══════════════════════╝ -->

            <LinearLayout
                android:id="@+id/tabCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Charges fixes"
                    android:textColor="#1A2E2B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Gérez vos charges récurrentes mensuelles."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/listCharges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal" >

                    <EditText
                        android:id="@+id/etNewCharge"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nom (ex: Loyer)"
                        android:paddingStart="12dp"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etNewChargeAmount"
                        android:layout_width="110dp"
                        android:layout_height="46dp"
                        android:background="@drawable/input_dialog"
                        android:hint="Montant"
                        android:inputType="numberDecimal"
                        android:paddingStart="12dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAddCharge"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_primary"
                    android:text="+ Ajouter une charge fixe"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDebug"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="📋🔍 DEBUG addPerson"
                    android:textColor="#1A2E2B"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
