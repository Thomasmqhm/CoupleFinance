<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- Avatar rond -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="14dp">
        <View
            android:id="@+id/viewBeneAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/avatar_terracotta"/>
        <TextView
            android:id="@+id/tvBeneInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="?"/>
    </FrameLayout>

    <!-- Infos bénéficiaire -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBeneficiaryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#1A2E2B"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="3dp"/>

        <TextView
            android:id="@+id/tvBeneficiaryIban"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvBeneficiaryLastTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Bouton Virer -->
    <Button
        android:id="@+id/tvDeleteBeneficiary"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="↗ Virer"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

</LinearLayout>
