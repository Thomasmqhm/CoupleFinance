<?xml version="1.0" encoding="utf-8"?>
<!-- Tablette : padding plus généreux -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F5F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LE POINT DU MOIS"
            android:textSize="11sp"
            android:textColor="#C0614A"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qui doit combien à qui ?"
            android:textSize="38sp"
            android:textColor="#1A2E2B"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ce mois-ci"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp"/>

        <!-- 2 cartes côte à côte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="55"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="32dp"
                android:layout_marginEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL DES DÉPENSES COMMUNES"
                    android:textSize="10sp"
                    android:textColor="#8B6914"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvTotalDepenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="42sp"
                    android:textColor="#1A2E2B"
                    android:textStyle="bold"
                    android:layout_marginBottom="28dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Objectif de répartition"
                        android:textSize="13sp" android:textColor="#64748B"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="50% / 50%"
                        android:textSize="13sp" android:textColor="#1A2E2B" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="12dp"
                    android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:background="#C0614A"/>
                    <View android:layout_width="2dp" android:layout_height="match_parent"
                        android:background="#F9F5F2"/>
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:background="#2D5A4E"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvPartIdéale"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="— idéal"
                        android:textSize="13sp" android:textColor="#C0614A" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvPartIdéale2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="— idéal"
                        android:textSize="13sp" android:textColor="#2D5A4E" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="45"
                android:orientation="vertical"
                android:background="@drawable/card_white"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="L'état actuel"
                    android:textSize="20sp"
                    android:textColor="#1A2E2B"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:id="@+id/containerResultats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SECTION REMBOURSEMENTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="40dp"
            android:gravity="center">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="ⓘ"
                android:textSize="30sp"
                android:textColor="#8B6914"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remboursements à effectuer"
                android:textSize="24sp"
                android:textColor="#1A2E2B"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pour équilibrer les comptes de ce mois-ci selon votre répartition 50/50, voici le virement nécessaire."
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <LinearLayout
                android:id="@+id/containerHistorique"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnReglerTout"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="✓  Tout régler"
                android:textSize="14sp"
                android:background="@drawable/btn_primary"
                android:textColor="#FFFFFF"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:layout_marginTop="18dp"/>

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="↻  Recalculer"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                android:textColor="#94A3B8"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
