<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_transactions.xml — tablet two-column layout (sw600dp)

  Left column  (34%): dark sidebar with title, action buttons, stats, filters
  Right column (66%): transaction list

  All IDs match the phone layout exactly so TransactionsView works unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTransactions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_beige"
    android:orientation="horizontal">

    <!-- ==================== LEFT COLUMN — Sidebar ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.34"
        android:background="@color/sidebar_dark"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title — single line, never wraps -->
        <TextView
            android:id="@+id/tvTransactionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Transactions"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gérez vos dépenses"
            android:textColor="@color/sidebar_label"
            android:textSize="13sp" />

        <!-- Action buttons: PDF / Image / Export / Add — match phone IDs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImportPdf"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@color/sidebar_item"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📄"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnImportImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@color/sidebar_item"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📷"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@color/sidebar_item"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="📊"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@color/accent_terracotta"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Stats card -->
        <LinearLayout
            android:id="@+id/statsRowsTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/sidebar_item"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SOLDE NET"
                android:textColor="@color/accent_terracotta"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatNet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="+0,00 €"
                android:textColor="@color/accent_terracotta"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/sidebar_separator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗ REVENUS"
                        android:textColor="@color/green_success"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatRevenues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="+0,00 €"
                        android:textColor="@color/green_success"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/sidebar_separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↘ DÉPENSES"
                        android:textColor="@color/sidebar_label"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="-0,00 €"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/sidebar_separator" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPÉRATIONS"
                        android:textColor="@color/sidebar_label"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Period filter buttons -->
        <HorizontalScrollView
            android:id="@+id/periodScrollTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/periodButtonsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFilterCurrentMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Ce mois"
                    android:textAllCaps="false"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFilterLastMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Mois préc."
                    android:textAllCaps="false"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFilterAll2"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Historique"
                    android:textAllCaps="false"
                    android:textSize="11sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Type segment (All / Income / Expense) -->
        <LinearLayout
            android:id="@+id/typeSegmentTransactions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@color/sidebar_item"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Tout"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnFilterIncome"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↗ Revenus"
                android:textAllCaps="false"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnFilterExpenses"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="↘ Dépenses"
                android:textAllCaps="false"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Advanced filters (hidden by default) -->
        <LinearLayout
            android:id="@+id/filtersExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/personScrollTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llPersonButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerPersonFilter"
            style="@style/SpinnerStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Toggle button for advanced filters -->
        <Button
            android:id="@+id/btnToggleFilters"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@color/sidebar_item"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⚙ Filtres"
            android:textAllCaps="false"
            android:textColor="@color/accent_terracotta"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ==================== RIGHT COLUMN — Transaction list ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.66"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search bar -->
        <LinearLayout
            android:id="@+id/searchCardTransactions"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/card_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:alpha="0.5"
                android:text="🔍"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Rechercher une opération..."
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- List header -->
        <LinearLayout
            android:id="@+id/listHeaderTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ce mois-ci"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Transaction list — same ID as phone -->
        <ListView
            android:id="@+id/listTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

    </LinearLayout>

</LinearLayout>
