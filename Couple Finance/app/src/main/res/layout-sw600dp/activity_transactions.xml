<?xml version="1.0" encoding="utf-8"?>
<!-- Tablette : liste à droite, stats + filtres à gauche (2 colonnes) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTransactions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_transactions_screen"
    android:orientation="horizontal">

    <!-- ── COLONNE GAUCHE : header + stats + filtres ── -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <!-- Header titre + boutons -->
        <LinearLayout
            android:id="@+id/headerTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transactions"
                android:textColor="#1E1B18"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <Button android:id="@+id/btnImportPdf"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/input_rounded"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:text="📄" android:textAllCaps="false" android:textSize="15sp"/>

            <Button android:id="@+id/btnImportImage"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/input_rounded"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:text="📷" android:textAllCaps="false" android:textSize="15sp"/>

            <Button android:id="@+id/btnExportCsv"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/input_rounded"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:text="📊" android:textAllCaps="false" android:textSize="15sp"/>

            <Button android:id="@+id/btnAdd"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:text="+" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- Recherche -->
        <LinearLayout
            android:id="@+id/searchCardTransactions"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/input_rounded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:alpha="0.38"
                android:text="🔍"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Rechercher..."
                android:singleLine="true"
                android:textColor="#1E1B18"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Stats card -->
        <LinearLayout
            android:id="@+id/statsRowsTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SOLDE NET"
                android:textColor="#C0614A"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvStatNet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="+0,00 €"
                android:textColor="#C0614A"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#1A000000"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗ REVENUS"
                        android:textColor="#6E9B76"
                        android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvStatRevenues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="+0,00 €"
                        android:textColor="#6E9B76"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#1A000000"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↘ DÉPENSES"
                        android:textColor="#8C7D76"
                        android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvStatExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="-0,00 €"
                        android:textColor="#1E1B18"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent"
                    android:background="#1A000000"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPÉ."
                        android:textColor="#8C7D76"
                        android:textSize="8sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvStatCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="#1E1B18"
                        android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Filtres période -->
        <HorizontalScrollView
            android:id="@+id/periodScrollTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/periodButtonsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnFilterCurrentMonth"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:minWidth="80dp" android:minHeight="0dp"
                    android:text="Ce mois" android:textAllCaps="false" android:textSize="11sp"/>
                <Button android:id="@+id/btnFilterLastMonth"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="80dp" android:minHeight="0dp"
                    android:text="Mois préc." android:textAllCaps="false" android:textSize="11sp"/>
                <Button android:id="@+id/btnFilterAll2"
                    android:layout_width="wrap_content" android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="80dp" android:minHeight="0dp"
                    android:text="Historique" android:textAllCaps="false" android:textSize="11sp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Type segment -->
        <LinearLayout
            android:id="@+id/typeSegmentTransactions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
            <Button android:id="@+id/btnFilterAll"
                android:layout_width="0dp" android:layout_height="30dp"
                android:layout_weight="1" android:minWidth="0dp" android:minHeight="0dp"
                android:text="Tout" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/btnFilterIncome"
                android:layout_width="0dp" android:layout_height="30dp"
                android:layout_marginStart="4dp" android:layout_weight="1"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="↗ Revenus" android:textAllCaps="false" android:textSize="11sp"/>
            <Button android:id="@+id/btnFilterExpenses"
                android:layout_width="0dp" android:layout_height="30dp"
                android:layout_marginStart="4dp" android:layout_weight="1"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="↘ Dépenses" android:textAllCaps="false" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Filtres avancés -->
        <LinearLayout
            android:id="@+id/filtersExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <HorizontalScrollView
                android:id="@+id/personScrollTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/llPersonButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Bouton Filtres (stub pour le Java) -->
        <Button android:id="@+id/btnToggleFilters"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:background="@drawable/input_rounded"
            android:minWidth="0dp" android:minHeight="0dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:text="⚙ Filtres" android:textAllCaps="false"
            android:textColor="#C0614A" android:textSize="11sp" android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <!-- Spinner stub -->
        <Spinner android:id="@+id/spinnerPersonFilter"
            style="@style/SpinnerStyle"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ── COLONNE DROITE : liste des transactions ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- En-tête liste -->
        <LinearLayout
            android:id="@+id/listHeaderTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ce mois-ci"
                android:textColor="#1E1B18"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ListView
            android:id="@+id/listTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:cacheColorHint="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="3dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:scrollbars="none"/>

        <!-- ScrollView stub pour compatibilité Java -->
        <ScrollView
            android:id="@+id/scrollTransactions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
