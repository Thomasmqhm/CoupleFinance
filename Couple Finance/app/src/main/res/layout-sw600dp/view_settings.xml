<?xml version="1.0" encoding="utf-8"?>
<!-- Tablette : contenu centré, max-width 680dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F5F2"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- HEADER centré max 680dp -->
    <LinearLayout
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:background="#F9F5F2"
        android:orientation="vertical"
        android:paddingEnd="40dp"
        android:paddingStart="40dp"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.12"
            android:text="CONFIGURATION"
            android:textColor="#8B6914"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Paramètres du Foyer"
            android:textColor="#1A2E2B"
            android:textSize="34sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Personnalisez votre espace commun."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:textStyle="italic"/>

        <!-- ONGLETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="36dp" android:orientation="vertical">
                <Button android:id="@+id/btnTabPersonnes"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp" android:paddingStart="0dp"
                    android:text="PERSONNES &amp; COULEURS"
                    android:textColor="#C0614A" android:textSize="11sp" android:textStyle="bold"/>
                <View android:layout_width="match_parent" android:layout_height="2dp"
                    android:background="#C0614A"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="36dp" android:orientation="vertical">
                <Button android:id="@+id/btnTabCategories"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp" android:paddingStart="0dp"
                    android:text="CATÉGORIES"
                    android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"/>
                <View android:layout_width="match_parent" android:layout_height="2dp"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical">
                <Button android:id="@+id/btnTabCharges"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:letterSpacing="0.05"
                    android:paddingEnd="0dp" android:paddingStart="0dp"
                    android:text="CHARGES FIXES"
                    android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold"/>
                <View android:layout_width="match_parent" android:layout_height="2dp"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#E8DDD6"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="680dp"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:paddingEnd="40dp"
            android:paddingStart="40dp"
            android:paddingTop="28dp">

            <!-- ONGLET PERSONNES -->
            <LinearLayout
                android:id="@+id/tabPersonnes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/listPersonnes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/etNewPerson"
                        android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_marginEnd="14dp" android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nom de la personne"
                        android:paddingStart="18dp" android:textSize="14sp"/>
                    <Button android:id="@+id/btnAddPerson"
                        android:layout_width="wrap_content" android:layout_height="52dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="24dp" android:paddingStart="24dp"
                        android:text="+ Inviter"
                        android:textColor="#FFFFFF" android:textSize="14sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginBottom="24dp" android:background="#F0EAE5"/>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:letterSpacing="0.10"
                    android:text="CODE D&apos;INVITATION"
                    android:textColor="#8B6914" android:textSize="10sp" android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/card_beige"
                    android:gravity="center" android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/tvCode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:letterSpacing="0.3"
                        android:text="——————"
                        android:textColor="#1A2E2B" android:textSize="42sp" android:textStyle="bold"/>
                </LinearLayout>

                <Button android:id="@+id/btnCopy"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="📋  Copier le code d&apos;invitation"
                    android:textColor="#1A2E2B" android:textSize="14sp"/>

                <Button android:id="@+id/btnLeaveHousehold"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="Quitter le foyer"
                    android:textColor="#C0614A" android:textSize="14sp"/>

                <Button android:id="@+id/btnLogout"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/btn_rounded_danger"
                    android:text="Se déconnecter"
                    android:textColor="#FFFFFF" android:textSize="14sp"/>
            </LinearLayout>

            <!-- ONGLET CATÉGORIES -->
            <LinearLayout
                android:id="@+id/tabCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" android:text="Catégories"
                    android:textColor="#1A2E2B" android:textSize="20sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Ajoutez, renommez ou supprimez des catégories."
                    android:textColor="#94A3B8" android:textSize="13sp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <View android:layout_width="4dp" android:layout_height="20dp"
                        android:layout_marginEnd="10dp" android:background="#16A34A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Revenus" android:textColor="#16A34A"
                        android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/listCatIncome"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:orientation="vertical"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp" android:orientation="horizontal">
                    <EditText android:id="@+id/etNewIncomeCat"
                        android:layout_width="0dp" android:layout_height="50dp"
                        android:layout_marginEnd="12dp" android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nouvelle catégorie de revenu"
                        android:paddingStart="14dp" android:textSize="14sp"/>
                    <Button android:id="@+id/btnAddIncomeCat"
                        android:layout_width="wrap_content" android:layout_height="50dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="20dp" android:paddingStart="20dp"
                        android:text="Ajouter" android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <View android:layout_width="4dp" android:layout_height="20dp"
                        android:layout_marginEnd="10dp" android:background="#C0614A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Dépenses" android:textColor="#C0614A"
                        android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/listCatExpense"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:orientation="vertical"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/etNewExpenseCat"
                        android:layout_width="0dp" android:layout_height="50dp"
                        android:layout_marginEnd="12dp" android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nouvelle catégorie de dépense"
                        android:paddingStart="14dp" android:textSize="14sp"/>
                    <Button android:id="@+id/btnAddExpenseCat"
                        android:layout_width="wrap_content" android:layout_height="50dp"
                        android:background="@drawable/btn_primary"
                        android:paddingEnd="20dp" android:paddingStart="20dp"
                        android:text="Ajouter" android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ONGLET CHARGES FIXES -->
            <LinearLayout
                android:id="@+id/tabCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_white"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" android:text="Charges fixes"
                    android:textColor="#1A2E2B" android:textSize="20sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Gérez vos charges récurrentes mensuelles."
                    android:textColor="#94A3B8" android:textSize="13sp"/>

                <LinearLayout android:id="@+id/listCharges"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp" android:orientation="vertical"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" android:orientation="horizontal">
                    <EditText android:id="@+id/etNewCharge"
                        android:layout_width="0dp" android:layout_height="50dp"
                        android:layout_marginEnd="12dp" android:layout_weight="1"
                        android:background="@drawable/input_dialog"
                        android:hint="Nom (ex: Loyer)"
                        android:paddingStart="14dp" android:textSize="14sp"/>
                    <EditText android:id="@+id/etNewChargeAmount"
                        android:layout_width="130dp" android:layout_height="50dp"
                        android:background="@drawable/input_dialog"
                        android:hint="Montant"
                        android:inputType="numberDecimal"
                        android:paddingStart="14dp" android:textSize="14sp"/>
                </LinearLayout>

                <Button android:id="@+id/btnAddCharge"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:background="@drawable/btn_primary"
                    android:text="+ Ajouter une charge fixe"
                    android:textColor="#FFFFFF" android:textSize="14sp"/>

                <Button android:id="@+id/btnDebug"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_rounded_light"
                    android:text="📋🔍 DEBUG addPerson"
                    android:textColor="#1A2E2B" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
