<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.couplefinance" >

    <!-- ── Permissions réseau ─────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Permissions biométrie ─────────────────────────────── -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ── Permissions stockage (API ≤ 28 seulement) ────────── -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ── Notifications ─────────────────────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        RECEIVE_BOOT_COMPLETED — permet de replanifier les alarmes
        de rappel de prélèvement après un redémarrage du téléphone.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        SCHEDULE_EXACT_ALARM — nécessaire sur API 31-32 pour
        AlarmManager.setExactAndAllowWhileIdle() (rappels ponctuels).
        Sur API 33+ USE_EXACT_ALARM est préféré.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
        USE_EXACT_ALARM — accordé automatiquement sur API 33+.
        Ne nécessite pas de demande utilisateur.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="CoupleFinance"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" >

        <!-- ── Activités ─────────────────────────────────────── -->

        <activity
            android:name=".MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".HouseholdActivity"
            android:exported="false" />

        <!-- ── Widget écran d'accueil ─────────────────────────── -->
        <!--
            SoldeWidget affiche le solde du foyer sur l'écran d'accueil.
            android:exported="true" obligatoire pour les AppWidgetProvider.
        -->
        <receiver
            android:name=".widget.SoldeWidget"
            android:exported="true"
            android:label="Solde CoupleFinance" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.couplefinance.UPDATE_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_solde_info" />
        </receiver>
        <receiver
            android:name=".data.BankAutoSyncManager$BankSyncReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.couplefinance.BANK_AUTO_SYNC" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ── Rappels prélèvements (AlarmManager) ───────────── -->
        <!--
            ChargeAlarmReceiver reçoit :
             1. Les alarmes planifiées par NotificationScheduler
             2. BOOT_COMPLETED pour replanifier après redémarrage
        -->
        <receiver
            android:name=".utils.NotificationScheduler$ChargeAlarmReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.couplefinance.CHARGE_REMINDER" />
                <action android:name="com.couplefinance.BALANCE_REMINDER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Digest Telegram quotidien (AlarmManager) ──────────── -->
        <receiver
            android:name=".data.TelegramDigestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.couplefinance.TELEGRAM_DIGEST" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Polling Telegram bidirectionnel (AlarmManager 15 min) ── -->
        <receiver
            android:name=".data.TelegramPollingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.couplefinance.TELEGRAM_POLL" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ── Actions boutons notification grosse dépense ─────── -->
        <receiver
            android:name=".data.TelegramActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.couplefinance.ACTION_EXPENSE_ACK" />
                <action android:name="com.couplefinance.ACTION_EXPENSE_CATEGORIZE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
